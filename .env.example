# =================================================================
# FinTrace: Financial Fraud Intelligence Platform Environment Config
# =================================================================

# Server & App Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="FinTrace"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Database Configuration (PostgreSQL in Docker / Local)
POSTGRES_USER=fintrace_user
POSTGRES_PASSWORD=fintrace_secure_password_2026
POSTGRES_DB=fintrace_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://fintrace_user:fintrace_secure_password_2026@localhost:5432/fintrace_db?schema=public"

# Authentication & Security
AUTH_SECRET="super-secret-jwt-key-for-sih-prototype-change-in-prod-2026"
AUTH_SESSION_EXPIRES_IN="24h"

# Logging & Debugging
LOG_LEVEL="debug" # 'error' | 'warn' | 'info' | 'debug'

# Risk & AI Engine Settings
AI_RISK_MODEL_VERSION="v1.0.0-sih-prototype"
RISK_HIGH_THRESHOLD=75
RISK_MEDIUM_THRESHOLD=45
